<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>

<AnchorPane stylesheets="@DarkTheme.css"
            styleClass="background"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.example.javalab3.controller.BookOverviewController"
            prefWidth="1100.0"
            prefHeight="650.0">

    <SplitPane dividerPositions="0.52"
               AnchorPane.topAnchor="0.0"
               AnchorPane.bottomAnchor="0.0"
               AnchorPane.leftAnchor="0.0"
               AnchorPane.rightAnchor="0.0">

        <items>

            <AnchorPane>

                <TableView fx:id="bookTable"
                           AnchorPane.topAnchor="10.0"
                           AnchorPane.bottomAnchor="10.0"
                           AnchorPane.leftAnchor="10.0"
                           AnchorPane.rightAnchor="10.0">

                    <columns>

                        <TableColumn fx:id="titleColumn"
                                     text="Название"
                                     prefWidth="180.0"/>

                        <TableColumn fx:id="bindingColumn"
                                     text="Переплёт"
                                     prefWidth="100.0"/>

                        <TableColumn fx:id="publisherColumn"
                                     text="Издательство"
                                     prefWidth="110.0"/>

                        <TableColumn fx:id="yearColumn"
                                     text="Год"
                                     prefWidth="70.0"/>

                        <TableColumn fx:id="genreColumn"
                                     text="Жанр"
                                     prefWidth="100.0"/>

                    </columns>

                </TableView>

            </AnchorPane>

            <AnchorPane>

                <Label text="Информация о книге"
                       styleClass="label-header"
                       layoutX="20.0"
                       layoutY="20.0"/>

                <GridPane layoutX="20.0"
                          layoutY="65.0"
                          hgap="20.0"
                          vgap="12.0">

                    <Label text="Название:"
                           GridPane.columnIndex="0"
                           GridPane.rowIndex="0"/>

                    <Label fx:id="titleLabel"
                           styleClass="label-bright"
                           GridPane.columnIndex="1"
                           GridPane.rowIndex="0"/>

                    <Label text="Переплёт:"
                           GridPane.columnIndex="0"
                           GridPane.rowIndex="1"/>

                    <Label fx:id="bindingLabel"
                           styleClass="label-bright"
                           GridPane.columnIndex="1"
                           GridPane.rowIndex="1"/>

                    <Label text="Издательство:"
                           GridPane.columnIndex="0"
                           GridPane.rowIndex="2"/>

                    <Label fx:id="publisherLabel"
                           styleClass="label-bright"
                           GridPane.columnIndex="1"
                           GridPane.rowIndex="2"/>

                    <Label text="Год издания:"
                           GridPane.columnIndex="0"
                           GridPane.rowIndex="3"/>

                    <Label fx:id="yearLabel"
                           styleClass="label-bright"
                           GridPane.columnIndex="1"
                           GridPane.rowIndex="3"/>

                    <Label text="Жанр:"
                           GridPane.columnIndex="0"
                           GridPane.rowIndex="4"/>

                    <Label fx:id="genreLabel"
                           styleClass="label-bright"
                           GridPane.columnIndex="1"
                           GridPane.rowIndex="4"/>

                </GridPane>

                <Label text="Информация об авторе"
                       styleClass="label-header"
                       layoutX="20.0"
                       layoutY="250.0"/>

                <GridPane layoutX="20.0"
                          layoutY="290.0"
                          hgap="20.0"
                          vgap="12.0">

                    <Label text="ФИО:"
                           GridPane.columnIndex="0"
                           GridPane.rowIndex="0"/>

                    <Label fx:id="authorNameLabel"
                           styleClass="label-bright"
                           GridPane.columnIndex="1"
                           GridPane.rowIndex="0"/>

                    <Label text="Телефон:"
                           GridPane.columnIndex="0"
                           GridPane.rowIndex="1"/>

                    <Label fx:id="authorPhoneLabel"
                           styleClass="label-bright"
                           GridPane.columnIndex="1"
                           GridPane.rowIndex="1"/>

                    <Label text="E-mail:"
                           GridPane.columnIndex="0"
                           GridPane.rowIndex="2"/>

                    <Label fx:id="authorEmailLabel"
                           styleClass="label-bright"
                           GridPane.columnIndex="1"
                           GridPane.rowIndex="2"/>

                    <Label text="Рейтинг:"
                           GridPane.columnIndex="0"
                           GridPane.rowIndex="3"/>

                    <Label fx:id="authorRatingLabel"
                           styleClass="label-bright"
                           GridPane.columnIndex="1"
                           GridPane.rowIndex="3"/>

                </GridPane>

                <HBox spacing="10.0"
                      layoutX="20.0"
                      layoutY="500.0">

                    <Button text="Добавить"
                            onAction="#handleNewBook"/>

                    <Button text="Изменить"
                            onAction="#handleEditBook"/>

                    <Button text="Удалить"
                            onAction="#handleDeleteBook"/>

                </HBox>

            </AnchorPane>

        </items>

    </SplitPane>

</AnchorPane>